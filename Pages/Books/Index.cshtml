@page "/"
@model Stefan_Pop_Lab2.Pages.BookPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<form asp-page="./Index" method="get">
    <div class="form-actions no-color">
        <p>
            Find by Book Title / Author Name:

            <input type="text"
                   name="searchString"
                   value="@Model.CurrentFilter" />

            <input type="submit"
                   value="Search"
                   class="btn btn-primary" />

            <a asp-page="./Index">Back to full List</a>
        </p>
    </div>
</form>

<table class="table">
    <thead>
        <tr>

            <th>
                <a asp-page="./Index" asp-route-sortOrder="@Model.TitleSort">
                    @Html.DisplayNameFor(model => model.Book[0].Title)
                </a>
            </th>

            <th>Author</th>
            <th>
                @Html.DisplayNameFor(model => model.Book[0].Price)

                <th>
                @Html.DisplayNameFor(model => model.Book[0].PublishingDate)

                    <th>
                        Publisher Name
                    </th>

                    <th>
                        Categories
                    </th>

                    <th>
                        <a asp-page="./Index" asp-route-sortOrder="@Model.AuthorSort">
                            Author
                        </a>
                    </th>



        </tr>
    </thead>
    <tbody>
                @foreach (var item in Model.BookD.Books)
                {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
                <td>
                    @(item.Authors?.FullName ?? "Fara autor")
                </td>
            <td>
                @Html.DisplayFor(model => item.Price)
                    <td>
                        @Html.DisplayFor(modelItem => item.PublishingDate)

                        <td>
                            @(item.Publisher?.PublisherName ?? "Fara editura")
                        </td>
                                <td>
                                    @foreach (var category in item.BookCategories)
                                    {
                                        <div>
                                            @category.CategoryID - @category.Category.CategoryName
                                        </div>
                                    }
                                </td>

            <td>
                <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
